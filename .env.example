DATABASE_URL=postgresql+psycopg://postgres:replace_with_local_postgres_password@localhost:5432/meeting_mvp
POSTGRES_DB=meeting_mvp
POSTGRES_USER=meeting_app
# Docker Compose가 DATABASE_URL을 만들 수 있도록 영문자/숫자/_/- 조합의 긴 값을 사용하세요.
POSTGRES_PASSWORD=replace_with_long_url_safe_password
# 로컬에서 80 포트가 사용 중이면 8088처럼 변경하세요. EC2 운영 기본값은 80입니다.
HTTP_PORT=80
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
DAILY_API_KEY=replace_me
DAILY_API_BASE_URL=https://api.daily.co/v1
DAILY_DOMAIN=replace_me.daily.co
DAILY_ROOM_TTL_MINUTES=180
DAILY_TOKEN_TTL_MINUTES=120
DAILY_REQUEST_TIMEOUT_SECONDS=5
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4o-mini
OPENAI_REQUEST_TIMEOUT_SECONDS=8
OPENAI_MAX_RETRIES=3
SQL_ECHO=false
